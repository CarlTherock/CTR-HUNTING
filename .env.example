# Field Terrain Intelligence — environment variables
#
# Copy this file to `.env` and fill in real values locally. `.env` is
# git-ignored; never commit real keys. Vite only exposes variables prefixed
# with VITE_ to client code — see https://vite.dev/guide/env-and-mode.
#
# Phase 0 (Foundation) does not call any external API and needs none of
# these to run `npm run dev`. They are declared here ahead of time so each
# variable is documented at the moment its phase introduces the adapter
# that consumes it, instead of appearing unexplained later.

# --- Phase 1: Map --------------------------------------------------------
# Base map / satellite / topo tile provider (exact provider TBD when Phase 1
# starts; see project instructions, "external providers must be replaceable").
# VITE_MAP_TILES_API_KEY=

# --- Phase 5: Weather ------------------------------------------------------
# VITE_WEATHER_API_KEY=

# --- Phase 4/8: Elevation / terrain data -----------------------------------
# VITE_ELEVATION_API_KEY=

# --- Phase 15: Synchronization / backend -----------------------------------
# VITE_SYNC_API_BASE_URL=
